# Copy this file to ".env" and fill in real values.
# ".env" is gitignored — your secrets never get committed.

# PostgreSQL connection string.
# Local Docker example:
#   postgresql://postgres:postgres@localhost:5432/inventory
# On Render this is provided automatically when you link a database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory

# Random string used to sign session cookies. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# Flask app module (for `flask ...` CLI commands).
FLASK_APP=app.py
